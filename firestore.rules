rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /boards/main/fields/{fieldId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'updatedBy'])
        && request.resource.data.value is string
        && request.resource.data.value.size() < 800000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if request.auth != null
        && fieldId in [
          'daily',
          'memo-0-content',
          'memo-1-content',
          'memo-2-content',
          'memo-3-content'
        ]
        && resource.data.updatedAt <= request.time - duration.value(30, 'd');
    }

    match /boards/main/images/{imageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['dataUrl', 'createdAt', 'createdBy'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('data:image/(webp|jpeg);base64,.*')
        && request.resource.data.dataUrl.size() < 430000
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
